<% add_decidim_page_title(t("title", scope: "decidim.geo.admin.shapefiles" )) %>
  <div class="card" id="shapefiles">
    <div class="item_show__header">
      <h1 class="item_show__header-title !w-1/2">
        <%= t("title", scope: "decidim.geo.admin.shapefiles" ) %>
      </h1>
      <div class="flex ml-auto items-center gap-x-4">
        <%= link_to t("actions.new_shapefile", scope: "decidim.geo.admin.shapefiles" ), new_shapefile_path,
          class: "button button__sm button__secondary hollow" %>
      </div>
    </div>


    <div class="table-scroll">
      <table class="table-list">
        <thead>
          <tr>
            <th>
              <%= I18n.t("fields.title", scope: "decidim.geo.admin.shapefiles" ) %>
            </th>
            <th>
              <%= I18n.t("fields.description", scope: "decidim.geo.admin.shapefiles" ) %>
            </th>
            <th>
              <%= I18n.t("fields.file_name", scope: "decidim.geo.admin.shapefiles" ) %>
            </th>
            <th>
              <%= I18n.t("fields.created_at", scope: "decidim.geo.admin.shapefiles" ) %>
            </th>
            <th>
              <%= I18n.t("fields.actions", scope: "decidim.geo.admin.shapefiles" ) %>
            </th>
          </tr>
        </thead>
        <tbody>
          <% @shapefiles.each do |shapefile| %>
            <tr>
              <td>
                <%= shapefile.title %><br>
              </td>
              <td>
                <%= shapefile.description %><br>
              </td>
              <td>
                <%= shapefile.shapefile.filename %><br>
              </td>
              <td>
                <%= shapefile.created_at %><br>
              </td>
              <td></td>
            </tr>
            <% end %>
        </tbody>
      </table>
    </div>
  </div>
  </div>