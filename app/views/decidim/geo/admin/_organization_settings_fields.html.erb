<%= f.check_box :enabled, label: t("enabled", scope: "decidim.geo.system") %>
<div id="decidim-geo-search-bar-field" class="field">
  <%= f.check_box :search_bar, label: t("search_bar", scope: "decidim.geo.system"), disabled: !f.object.enabled, id: "search_bar_checkbox" %>
</div>
<script>
  (function() {
    const root = document.getElementById("decidim-geo-search-bar-field");
    if (!root) return;

    const enabledInput = root.closest("form")?.querySelector('input[name*="[enabled]"]');
    const searchBarInput = root.querySelector('input[name*="[search_bar]"]');
    if (!enabledInput || !searchBarInput) return;

    function syncSearchBarState() {
      const enabled = enabledInput.checked;
      searchBarInput.disabled = !enabled;
      if (!enabled) searchBarInput.checked = false;
    }

    enabledInput.addEventListener("change", syncSearchBarState);
    syncSearchBarState();
  })();
</script>
